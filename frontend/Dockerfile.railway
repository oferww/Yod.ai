# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Build the app with Railway env vars
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Copy custom nginx config WITHOUT backend proxy
COPY nginx/default.railway.conf /etc/nginx/conf.d/default.conf

# Copy built files
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]